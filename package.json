{
  "name": "teledoc",
  "version": "1.0.0",
  "private": true,
  "description": "TeleDoc Ghana - Telemedicine & Teleconsultation Platform",
  "workspaces": [
    "api",
    "web",
    "mobile",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --prefix api run dev",
    "dev:web": "npm --prefix web run dev",
    "dev:mobile": "npm --prefix mobile start",
    "db:migrate": "npx prisma db push --schema=api/prisma/schema.prisma",
    "db:seed": "npx ts-node-dev api/prisma/seed.ts",
    "db:studio": "npx prisma studio --schema=api/prisma/schema.prisma"
  },
  "devDependencies": {
    "react-refresh": "^0.14.2",
    "typescript": "^5.7.3"
  }
}
