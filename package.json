{
  "name": "teledoc",
  "version": "1.0.0",
  "private": true,
  "description": "TeleDoc Ghana - Telemedicine & Teleconsultation Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --prefix apps/api run dev",
    "dev:admin": "npm --prefix apps/admin run dev",
    "dev:mobile": "npm --prefix apps/mobile start",
    "build:all": "npm run build --workspaces --if-present",
    "db:migrate": "npm --prefix apps/api run prisma:migrate",
    "db:seed": "npm --prefix apps/api run prisma:seed",
    "db:studio": "npm --prefix apps/api run prisma:studio"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
